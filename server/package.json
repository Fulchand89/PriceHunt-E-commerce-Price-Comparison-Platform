{
  "name": "pricehunt-server",
  "version": "2.0.0",
  "description": "PriceHunt — Production-Ready E-Commerce Price Comparison Platform API",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrations/migrate.js",
    "migrate:status": "node src/migrations/migrate.js --status",
    "migrate:fresh": "node src/migrations/migrate.js --fresh",
    "test": "node test_full_suite.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "redis": "^4.6.15",
    "sequelize": "^6.37.0",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "nodemonConfig": {
    "watch": [
      "src/"
    ],
    "ext": "js,json",
    "ignore": [
      "src/**/*.test.js"
    ],
    "delay": "500"
  }
}
