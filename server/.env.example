# ==============================================================================
# PriceHunt Production Environment Variables
# ==============================================================================

NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pricehunt

# Redis (Optional: Falls back to built-in in-memory cache if omitted)
REDIS_URL=

# Authentication & Security
JWT_SECRET=your_super_secret_production_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Server-Side Scraping Configuration
SCRAPER_ENABLED=true
SCRAPER_TIMEOUT=15000
SCRAPER_CONCURRENCY=3
SCRAPER_CACHE_TTL=600

# Background Job Cron Expressions (Asia/Kolkata timezone)
PRICE_UPDATE_CRON=0 */2 * * *
ALERT_CHECK_CRON=*/5 * * * *
SCRAPER_JOB_CRON=0 */3 * * *
CRON_TIMEZONE=Asia/Kolkata

# Admin Seed Account
ADMIN_EMAIL=admin@pricehunt.com
ADMIN_PASSWORD=Admin@12345

# SMTP / Email Notifications (Optional for Price Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PriceHunt Alerts <alerts@pricehunt.app>
